DATABASE_URL=
REDIS_URL=


JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5174

APP_ENV=development
# Comma-separated list of allowed origins for the frontend (see ../frontend).
# Leaving this blank disables CORS entirely, which breaks the Vite dev server.
# IMPORTANT: Must match the port where your frontend Vite server is running (default 5174)
CORS_ORIGINS=http://localhost:5174


# Cloudflare R2 (photo storage) — create an R2 API token in the Cloudflare dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# Transactional mail for signup verification codes, password resets and welcomes.
#
# Brevo over the alternatives for one reason: its free tier (300/day, no expiry)
# lets you send from a single verified mailbox without owning a domain. Resend,
# MailerSend and Mailgun all restrict domainless accounts to emailing the account
# holder, which cannot power a real signup flow.
#
# Setup:
#   1. Sign up at https://www.brevo.com (free, no card).
#   2. Senders, Domains & Dedicated IPs -> Senders -> Add a sender.
#      Use your own address and click the confirmation link Brevo emails you.
#   3. SMTP & API -> API Keys -> Generate a new API key (v3).
#
# Leave BREVO_API_KEY blank and nothing is sent: codes are written to the server
# log instead, and the app keeps working. That is the intended local default.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PawSome

# Blocks swiping and matching until the address is confirmed (403
# EMAIL_VERIFICATION_REQUIRED). Set false to downgrade it to a prompt, e.g. if
# mail delivery breaks and you don't want everyone locked out of the core feature.
REQUIRE_EMAIL_VERIFICATION=true

# ── Ola Maps (optional, and deliberately unset) ───────────────────────────────
# Would upgrade /travel/eta from straight-line distance to real road distance
# and drive time. Ola's routing is tuned for India and the free tier is 500K
# calls/month, which is why it was chosen.
#
# BUT: as of 2026-07, Krutrim Cloud will not issue Ola Maps credentials without
# registering a credit card for autopay (Ola Maps -> Offerings -> Credentials
# prompts "Setup Autopay ... Required to create and use credentials"). Their
# marketing pages still say "no credit card required" — that is not what the
# console does. We chose not to attach a payment method to a metered API for a
# decorative distance label.
#
# So this stays blank on purpose, and /travel/eta answers with haversine
# straight-line distance: the UI says "4.2 km away" instead of
# "4.2 km · ~15 min drive". Everything works; only the drive time is missing.
#
# If you ever do get a key, paste it below and restart — no code change needed.
# The same fallback covers a wrong/expired key or an Ola outage, because a
# distance label must never be the reason a card fails.
# See docs/LOCATION_AND_MAPS.md §4.5.
#
# Weather, air quality, nearby places and map links need no key at all.
OLA_MAPS_API_KEY=
OLA_MAPS_BASE_URL=https://api.olamaps.io
