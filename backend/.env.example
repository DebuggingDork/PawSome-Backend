DATABASE_URL=
REDIS_URL=


JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:5174

APP_ENV=development
# Comma-separated list of allowed origins for the frontend (see ../frontend).
# Leaving this blank disables CORS entirely, which breaks the Vite dev server.
# IMPORTANT: Must match the port where your frontend Vite server is running (default 5174)
CORS_ORIGINS=http://localhost:5174


# Cloudflare R2 (photo storage) — create an R2 API token in the Cloudflare dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# Transactional mail for signup verification codes, password resets and welcomes.
#
# Brevo over the alternatives for one reason: its free tier (300/day, no expiry)
# lets you send from a single verified mailbox without owning a domain. Resend,
# MailerSend and Mailgun all restrict domainless accounts to emailing the account
# holder, which cannot power a real signup flow.
#
# Setup:
#   1. Sign up at https://www.brevo.com (free, no card).
#   2. Senders, Domains & Dedicated IPs -> Senders -> Add a sender.
#      Use your own address and click the confirmation link Brevo emails you.
#   3. SMTP & API -> API Keys -> Generate a new API key (v3).
#
# Leave BREVO_API_KEY blank and nothing is sent: codes are written to the server
# log instead, and the app keeps working. That is the intended local default.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PawSome

# Blocks swiping and matching until the address is confirmed (403
# EMAIL_VERIFICATION_REQUIRED). Set false to downgrade it to a prompt, e.g. if
# mail delivery breaks and you don't want everyone locked out of the core feature.
REQUIRE_EMAIL_VERIFICATION=true
